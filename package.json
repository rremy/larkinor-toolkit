{
  "name": "larkinor-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial companion tooling for the Larkinor browser RPG: a userscript UI and a standalone database explorer",
  "repository": {
    "type": "git",
    "url": "https://github.com/rremy/larkinor-toolkit.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:db": "vite --config vite.config.db.ts",
    "build": "npm run build:userscript && npm run build:db",
    "build:userscript": "vite build",
    "build:db": "vite build --config vite.config.db.ts",
    "build:site": "npm run build && npm run copy:data",
    "copy:data": "mkdir -p dist/static && cp -R static/. dist/static/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "serve": "python3 -m http.server 9000 --directory dist"
  },
  "dependencies": {
    "preact": "^10.23.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.2",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.5.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.0",
    "@types/tampermonkey": "^4.20.0",
    "@vitest/coverage-v8": "^1.6.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vite-plugin-monkey": "^4.0.0",
    "vitest": "^1.6.0"
  }
}
